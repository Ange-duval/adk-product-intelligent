<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_adk_root" name="ADK Produits Intelligents" sequence="25" web_icon="adk_product_intelligent,static/description/icon.png"/>

    <menuitem id="menu_adk_families" name="Familles d'articles" parent="menu_adk_root"
              action="action_adk_product_family" sequence="10"/>

    <menuitem id="menu_adk_bulk_config" name="Configuration en lot" parent="menu_adk_root"
              action="action_adk_bulk_config_wizard" sequence="20"/>

    <record id="action_adk_product_template" model="ir.actions.act_window">
        <field name="name">Articles</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <menuitem id="menu_adk_products" name="Articles" parent="menu_adk_root"
              action="action_adk_product_template" sequence="30"/>

    <record id="action_server_adk_stock_alerts" model="ir.actions.server">
        <field name="name">Alertes de seuil de stock</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">action = model.action_view_adk_stock_alerts()</field>
    </record>

    <menuitem id="menu_adk_stock_alerts" name="⚠ Alertes de stock" parent="menu_adk_root"
              action="action_server_adk_stock_alerts" sequence="5"/>

    <record id="action_adk_product_category" model="ir.actions.act_window">
        <field name="name">Catégories</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_adk_categories" name="Catégories" parent="menu_adk_root"
              action="action_adk_product_category" sequence="40"/>

    <record id="action_adk_stock_orderpoint" model="ir.actions.act_window">
        <field name="name">Seuils / Règles de réapprovisionnement</field>
        <field name="res_model">stock.warehouse.orderpoint</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">Aucune règle de réapprovisionnement</p>
            <p>Ces règles sont générées automatiquement par ADK lorsque vous définissez des
               seuils de sécurité sur un article ou une famille d'articles. Vous pouvez
               également en créer manuellement ici : elles resteront visibles depuis le
               module Inventaire natif.</p>
        </field>
    </record>

    <menuitem id="menu_adk_orderpoints" name="Seuils / Réappro. (Inventaire)" parent="menu_adk_root"
              action="action_adk_stock_orderpoint" sequence="50"
              groups="stock.group_stock_manager"/>

</odoo>
