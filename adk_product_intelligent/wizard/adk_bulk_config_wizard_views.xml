<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_adk_bulk_config_wizard_form" model="ir.ui.view">
        <field name="name">adk.bulk.config.wizard.form</field>
        <field name="model">adk.bulk.config.wizard</field>
        <field name="arch" type="xml">
            <form string="Configuration en lot ADK">
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="state == 'done'">
                        Configurez un lot d'articles en une seule opération : famille, catégorie, code,
                        seuils de sécurité et comptes comptables. Tout est automatiquement synchronisé
                        avec le module Inventaire et la Comptabilité.
                    </div>
                    <div class="alert alert-success" role="alert" invisible="state != 'done'">
                        <field name="result_message"/>
                    </div>

                    <group string="1. Filtrer les articles (facultatif si une sélection a déjà été faite)">
                        <group>
                            <field name="filter_type"/>
                            <field name="filter_category_id"/>
                            <field name="filter_family_id"/>
                        </group>
                        <group>
                            <field name="filter_name"/>
                            <field name="filter_no_family"/>
                            <field name="filter_active_only"/>
                        </group>
                    </group>
                    <button name="action_search" type="object" string="Rechercher les articles"
                            class="btn-secondary" icon="fa-search"/>

                    <group string="Articles concernés">
                        <field name="product_count"/>
                        <field name="product_ids" nolabel="1" colspan="2">
                            <list editable="bottom" create="0">
                                <field name="name"/>
                                <field name="categ_id"/>
                                <field name="adk_family_id"/>
                                <field name="adk_code"/>
                                <field name="adk_seuil_min"/>
                                <field name="adk_seuil_max"/>
                            </list>
                        </field>
                    </group>

                    <separator string="2. Choisir les modifications à appliquer en lot"/>
                    <group>
                        <group string="Famille &amp; Catégorie">
                            <field name="apply_family"/>
                            <field name="family_id" invisible="not apply_family" required="apply_family"/>
                            <field name="apply_category"/>
                            <field name="category_id" invisible="not apply_category" required="apply_category"/>
                            <field name="apply_code"/>
                            <field name="use_as_reference" invisible="not apply_code"/>
                        </group>
                        <group string="Immobilisation &amp; Comptes">
                            <field name="apply_immobilisation"/>
                            <field name="is_immobilisation" invisible="not apply_immobilisation"/>
                            <field name="apply_comptes"/>
                            <field name="compte_achat_id" invisible="not apply_comptes"/>
                            <field name="compte_vente_id" invisible="not apply_comptes"/>
                            <field name="compte_immobilisation_id" invisible="not apply_comptes"/>
                        </group>
                    </group>
                    <group string="Seuils de sécurité (synchronisés avec Inventaire)">
                        <field name="apply_seuils"/>
                        <group invisible="not apply_seuils">
                            <field name="seuil_min"/>
                            <field name="seuil_max"/>
                            <field name="qty_multiple"/>
                        </group>
                        <group invisible="not apply_seuils">
                            <field name="reordering_trigger"/>
                            <field name="warehouse_id"/>
                        </group>
                    </group>
                    <field name="state" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Appliquer à tous les articles"
                            class="btn-primary" icon="fa-check" invisible="state == 'done'"
                            confirm="Cette action va modifier tous les articles listés ci-dessus et les synchroniser avec l'Inventaire. Continuer ?"/>
                    <button name="action_view_result_products" type="object" string="Voir les articles"
                            class="btn-primary" invisible="state != 'done'"/>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_adk_bulk_config_wizard" model="ir.actions.act_window">
        <field name="name">Configuration en lot</field>
        <field name="res_model">adk.bulk.config.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
